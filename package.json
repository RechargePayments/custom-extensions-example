{
  "name": "featured-product",
  "version": "0.1.0",
  "description": "A Lit Web Component that renders a featured product.",
  "type": "module",
  "main": "dist/featured-product.js",
  "module": "dist/featured-product.js",
  "exports": {
    ".": {
      "import": "./dist/featured-product.js",
      "types": "./dist/featured-product.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "upload": "npm run build && wrangler r2 object put $R2_BUCKET/featured-product.js --file dist/featured-product.js"
  },
  "keywords": [
    "web-component",
    "lit",
    "custom-element"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@rechargeapps/storefront-client": "^1.80.0",
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wrangler": "^3.0.0"
  }
}
