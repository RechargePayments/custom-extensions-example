{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist",
    "sourceMap": true
  },
  "include": ["src"]
}
